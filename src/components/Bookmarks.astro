<section class="bookmarks-card" aria-label="Bookmark manager">
  <form id="add-bookmark">
    <div class="field">
      <label for="url">Link to save</label>
      <input
        id="url"
        name="url"
        type="text"
        inputmode="url"
        autocomplete="url"
        spellcheck="false"
        placeholder="example.com"
        required
      />
    </div>
    <button type="submit">Add bookmark <span aria-hidden="true">↗</span></button>
  </form>

  <p class="hint">Add a website with or without <code>https://</code>. We’ll give it a short <code>mona-</code> link.</p>
  <p id="bookmark-status" class="status" role="status" aria-live="polite"></p>

  <p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

  <div id="list-header" hidden>
    <h2 class="list-title">Saved bookmarks</h2>
    <button id="clear-all" type="button" class="clear">Clear all</button>
  </div>

  <ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite"></ul>
</section>

<script>
  import { encodeSlug, formatBookmark, normalizeUrl, parseStoredBookmarks } from '../lib/bookmarks';
  import type { Bookmark } from '../lib/bookmarks';

  const form = document.getElementById('add-bookmark');
  const input = document.getElementById('url') as HTMLInputElement | null;
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearButton = document.getElementById('clear-all');
  const status = document.getElementById('bookmark-status');
  const storageKey = 'mona-bookmarks';
  let bookmarks: Bookmark[] = [];

  const report = (message: string) => {
    if (status) status.textContent = message;
  };

  const persist = () => {
    try {
      localStorage.setItem(storageKey, JSON.stringify(bookmarks));
      return true;
    } catch {
      report('Your browser could not save this bookmark. It may not survive a reload.');
      return false;
    }
  };

  const render = () => {
    if (!list || !emptyState || !listHeader) return;
    list.replaceChildren();
    emptyState.hidden = bookmarks.length > 0;
    listHeader.hidden = bookmarks.length === 0;

    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const separator = document.createElement('span');
      separator.className = 'separator';
      separator.textContent = ' :: ';

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const copyButton = document.createElement('button');
      copyButton.className = 'copy';
      copyButton.type = 'button';
      copyButton.textContent = 'Copy';
      copyButton.setAttribute('aria-label', `Copy ${bookmark.slug}`);
      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          report(`Copied ${bookmark.slug}.`);
        } catch {
          report('Could not access the clipboard. Select and copy the slug instead.');
        }
      });

      item.append(link, separator, slug, copyButton);
      list.append(item);
    }
  };

  try {
    bookmarks = parseStoredBookmarks(localStorage.getItem(storageKey));
  } catch {
    bookmarks = [];
    report('Saved bookmarks are unavailable in this browser.');
  }
  render();

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    try {
      if (!input) throw new Error('The URL field is unavailable.');
      const url = normalizeUrl(input.value);
      let slug: string;
      do {
        const random = new Uint32Array(1);
        crypto.getRandomValues(random);
        slug = encodeSlug(random[0]);
      } while (bookmarks.some((bookmark) => bookmark.slug === slug));

      bookmarks = [...bookmarks, { url, slug }];
      const saved = persist();
      render();
      if (saved) report(`Saved ${formatBookmark({ url, slug })}.`);
      input.value = '';
      input.focus();
    } catch (error) {
      report(error instanceof Error ? error.message : 'Could not add that bookmark.');
    }
  });

  clearButton?.addEventListener('click', () => {
    if (!window.confirm('Clear all saved bookmarks from this device?')) return;
    bookmarks = [];
    let removed = false;
    try {
      localStorage.removeItem(storageKey);
      removed = true;
    } catch {
      // The list is cleared in memory even if browser storage is unavailable.
    }
    render();
    report(
      removed
        ? 'All bookmarks cleared.'
        : 'Bookmarks cleared from this page, but browser storage could not be updated.',
    );
  });
</script>

<style>
  .bookmarks-card {
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) * 1.5);
    background: color-mix(in srgb, currentColor 3%, transparent);
    box-shadow: 0 1rem 2.5rem color-mix(in srgb, currentColor 5%, transparent);
  }

  form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    align-items: end;
  }

  .field {
    display: flex;
    flex: 1 1 16rem;
    flex-direction: column;
    gap: 0.4rem;
  }

  label { font-size: 0.85rem; font-weight: 600; }

  input {
    width: 100%;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: transparent;
    color: inherit;
    font: inherit;
    transition: border-color 140ms ease, box-shadow 140ms ease;
  }

  input:focus-visible {
    border-color: var(--accent);
    outline: none;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 25%, transparent);
  }

  button {
    padding: 0.7rem 1rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: var(--accent);
    color: #fff;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  button:hover { filter: brightness(1.08); }

  .hint, .status { min-height: 1.25rem; margin: 0.75rem 0 1.25rem; font-size: 0.8rem; color: var(--muted); }
  .status:empty { display: none; }
  .status:not(:empty) { min-height: 0; }

  #list-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0.5rem 0;
  }

  .list-title { margin: 0; font-size: 1rem; font-family: var(--font-head); }

  .clear, .copy {
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--border);
    background: transparent;
    color: inherit;
    font-size: 0.8rem;
    font-weight: 500;
  }

  .clear:hover, .copy:hover { border-color: currentColor; }

  ul { display: grid; gap: 0.55rem; margin: 0; padding: 0; list-style: none; }

  li.bookmark {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.35rem;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: color-mix(in srgb, currentColor 2%, transparent);
  }

  .url { min-width: 0; flex: 1 1 12rem; overflow-wrap: anywhere; color: inherit; }
  .separator { white-space: pre; color: var(--muted); }
  .slug {
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 18%, transparent);
    font-family: var(--font-body);
    font-size: 0.85rem;
  }

  .empty {
    margin: 0;
    padding: 1.5rem;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    color: var(--muted);
    text-align: center;
  }

  [hidden] { display: none !important; }

  @media (max-width: 30rem) {
    .bookmarks-card { padding: 1rem; }
    form > button { width: 100%; }
  }
</style>
